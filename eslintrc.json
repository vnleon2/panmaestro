{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "supabase": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "vars": "local",
        "args": "after-used",
        "argsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": ["warn", "smart"],
    "no-empty": ["warn", { "allowEmptyCatch": false }],
    "no-undef": "off",
    "no-redeclare": "warn",
    "no-cond-assign": ["error", "except-parens"]
  }
}
